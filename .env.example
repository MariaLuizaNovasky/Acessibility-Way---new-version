# Copie para .env (ou cadastre no painel do Render). Nunca suba o arquivo .env para o GitHub.

# Supabase > Connect > Session pooler (funciona em IPv4, necessário no Render)
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_ou_secret

# Bucket privado criado pelo Data/schema.sql
SUPABASE_BUCKET=documentos-pedestres

# Defina como false se preferir rodar o Data/schema.sql manualmente
DATABASE_AUTO_MIGRATE=true
